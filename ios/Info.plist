	<string>Calendar access is used to add the 2027 International Nursing Conference to your calendar.</string>
	
	<!-- For iOS 16 and earlier: Standard calendar access -->
	<key>NSCalendarsUsageDescription</key>
	<string>Calendar access is used to add the 2027 International Nursing Conference to your calendar.</string>
</dict>
</plist>
