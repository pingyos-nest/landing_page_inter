# Copy to .env and fill in. Never commit .env.
ADMIN_EMAIL=admin_inter@cmu.ac.th
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Comma-separated origins allowed to call the API cross-origin
ALLOWED_ORIGINS=https://www.nurse.cmu.ac.th,https://nurse.cmu.ac.th
# Microsoft Entra ID (Azure AD) sign-in — register redirect URI <site>/auth/microsoft/callback
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
# Comma-separated Microsoft accounts allowed into admin (ADMIN_EMAIL is always allowed)
ADMIN_EMAILS=
# Optional: exact redirect URI registered in Azure, e.g. https://example.com/inter2027/auth/microsoft/callback
AZURE_REDIRECT_URI=
